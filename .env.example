# ==============================================================================
# 中国律师 AI 工具箱 (CN Lawyer AI Toolbox) — 环境变量配置模板
# 复制为 .env 后按需修改；所有项均可选，不配置也可开箱即用！
# ==============================================================================

# 1. 前端白标与访问模式配置（构建时生效）
# open    = 个人律师免登录开箱即用（默认）
# license = 律所团队模式（需先运行 `npm run init-keys` 生成本所专属 ECDSA 密钥对）
VITE_AUTH_MODE=open
VITE_APP_NAME=中国律师 AI 工具箱
VITE_FIRM_NAME=
# 可选：填写本所 OA 链接后，首页会自动出现快捷入口
VITE_OA_URL=
VITE_OA_LABEL=律所 OA 系统

# 2. 服务端运行配置（仅在使用 Node/Docker 后端网关时需要）
PORT=3681
BIND_HOST=127.0.0.1
# 与 VITE_AUTH_MODE 保持一致：open 或 license
AUTH_MODE=open
# 无状态跨域 AI 转发开关（若公开暴露到公网且 AUTH_MODE=open，建议设为 false 或配合反向代理鉴权）
ENABLE_AI_RELAY=true
AI_RELAY_RPM_LIMIT=60

# 3. 可选：接入腾讯 IMA OpenAPI（用于云端知识库检索与服务端 poppler PDF 正文提取）
# 在 https://ima.qq.com/agent-interface 获取后填写；不填也不影响全部离线工具与公开分享链接跳转
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_PRIMARY_KB_NAME=法律法规案例库（持续更新）
IMA_KB_SHARE_URL=https://ima.qq.com/wiki/?shareId=a5d4993fac94797dc3892f0157c5a4011efd105c495d2b0e45ac311dc7dda91b
